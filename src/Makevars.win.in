TARGET = @WINDOWS_TARGET@

TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/librattlerthis.a
DOCUMENT = rust/document.exe

# See the matching comment in Makevars.in: captures rustc's own
# `--print=native-static-libs` output so PKG_LIBS doesn't silently omit
# something `librattlerthis.a` actually needs at final-link time. On Windows
# native-tls goes through SChannel, which needs `-lsecur32 -lcrypt32
# -lncrypt` and friends -- not covered by the hardcoded libs below.
#
# As in Makevars.in: PKG_LIBS is fine for R's own $(SHLIB) rule (a separate
# rule, run after $(NATIVE_LIBS) exists), but the document step inside
# $(STATLIB)'s recipe must use a shell-level `$$(cat ...)`: make expands a
# whole recipe before running any of it, so on a from-scratch build
# `$(shell cat ...)` would expand to nothing.
#
# Some of those libraries are import libraries that crates ship themselves
# (`windows_x86_64_gnu`, `winapi-x86_64-pc-windows-gnu`): `-lwindows.0.48.5`,
# `-lwinapi_advapi32` and so on. Cargo finds them through the crates' build
# scripts (`cargo:rustc-link-search`), but R's final link does not, and in a
# build from crates.io they live under $(CARGOTMP), which is deleted before
# that link. The $(STATLIB) recipe copies them into $(LIBDIR), which PKG_LIBS
# already searches. It reads the directories one per line, so a path with a
# space (`C:\Users\First Last\...`) stays one directory.
NATIVE_LIBS = $(TARGET_DIR)/native-libs.txt
PKG_LIBS = -L$(LIBDIR) -lrattlerthis -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll $(shell cat $(NATIVE_LIBS) 2>/dev/null)

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = vendor
VENDOR_MARKER = $(VENDOR_DIR)/.extracted-from-vendor-tarball

$(STATLIB):
	mkdir -p "$(CARGOTMP)/libgcc_mock"
	touch "$(CARGOTMP)/libgcc_mock/libgcc_eh.a"

  # If vendor.tar.xz exists, it is extracted and used for offline compilation.
  # A vendor directory left by an earlier extraction (marked with
  # $(VENDOR_MARKER)) is extracted again: a failed build skips rust_clean, and
  # reusing its tree would build a stale or older dependency set. A vendor
  # directory without the marker was supplied by hand and is used as is.
  # Cargo skips dot-files in a vendor directory, so the marker is harmless.
	if [ -f ./rust/vendor.tar.xz ] && { [ ! -d ./vendor ] || [ -f "$(VENDOR_MARKER)" ]; }; then \
		echo "=== Using offline vendor tarball ==="; \
		rm -rf ./vendor && \
		tar xf rust/vendor.tar.xz && \
		touch "$(VENDOR_MARKER)" && \
		mkdir -p "$(CARGOTMP)" && \
		cp rust/vendor-config.toml "$(CARGOTMP)/config.toml"; \
	elif [ -d ./vendor ]; then \
		echo "=== Using offline vendor directory ==="; \
		mkdir -p "$(CARGOTMP)" && \
		cp rust/vendor-config.toml "$(CARGOTMP)/config.toml"; \
	fi

	# Build the project using Cargo with additional flags. The target
	# directory must exist before cargo's stderr is redirected into it.
	mkdir -p "$(TARGET_DIR)" && \
	export CARGO_HOME="$(CARGOTMP)" && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CARGOTMP)/libgcc_mock" && \
	RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build @CRAN_FLAGS@ --target=$(TARGET) --lib @PROFILE@ --manifest-path=rust/Cargo.toml --target-dir="$(TARGET_DIR)" 2> "$(TARGET_DIR)/cargo-build.stderr"; \
	build_status=$$?; \
	cat "$(TARGET_DIR)/cargo-build.stderr" 1>&2; \
	grep 'native-static-libs:' "$(TARGET_DIR)/cargo-build.stderr" | tail -n1 | sed 's/.*native-static-libs: *//' > $(NATIVE_LIBS); \
	cat $(LIBDIR)/build/*/output 2>/dev/null | grep '^cargo:rustc-link-search=' | sed -e 's/^cargo:rustc-link-search=//' -e 's/^[a-z]*=//' -e 's|\\|/|g' | while IFS= read -r dir; do \
		case "$$dir" in \
			*/vendor/*|*/registry/src/*) cp -f "$$dir"/*.a "$(LIBDIR)/" 2>/dev/null || true ;; \
		esac; \
	done; \
	exit $$build_status

	# Regenerate R/extendr-wrappers.R using the linked C executable (replaces
	# the old `cargo run --bin document`, which rebuilt the whole dependency
	# graph a second time at install).
	#
	# Two gates -- see the matching comment in Makevars.in: the
	# tools/config.R-filled flag keeps CRAN builds from writing into the
	# source tree, and $ROXYGEN_PKG (set by roxygen2 only while documenting;
	# upstream rextendr #541) keeps plain dev builds from churning the
	# wrappers' mtime and re-triggering full crate recompiles.
	if [ -n "@DOCUMENT_FLAG@" ] && [ -n "$$ROXYGEN_PKG" ]; then \
		echo "=== Regenerating R/extendr-wrappers.R ==="; \
		$(CC) -o $(DOCUMENT) rust/document.c -L$(LIBDIR) -lrattlerthis -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll $$(cat $(NATIVE_LIBS)) -L"$(R_HOME)/bin$(R_ARCH)" -lR && \
		./$(DOCUMENT) $(R_PACKAGE_NAME) ../R/extendr-wrappers.R; \
		doc_status=$$?; \
		rm -f $(DOCUMENT); \
		exit $$doc_status; \
	fi

	# Always clean up CARGOTMP
	rm -Rf "$(CARGOTMP)";

rust_clean: $(SHLIB)
	rm -Rf "$(CARGOTMP)" "$(VENDOR_DIR)" @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) "$(TARGET_DIR)" "$(VENDOR_DIR)" $(DOCUMENT)
